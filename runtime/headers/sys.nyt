#ifndef SYS_NYT
#define SYS_NYT

namespace sys {

// I/O (flags: O_RDONLY=0, O_WRONLY=1, O_RDWR=2, O_CREAT=64)
extern int open(string filename, int flags);
extern int close(int fd);
extern int read(int fd, char* buf, int n);
extern int write(int fd, string buf, int n);

// Process Management
extern int fork();
extern int execve(string filename, char** argv, char** envp);
extern int execv(char* pathname, char** argv);
extern int waitpid(int pid, char* status, int options);
extern int getpid();

// Memory (addr: usually pass 0)
extern char* mmap(char* addr, int len, int prot, int flags, int fd, int offset);

// Networking
extern int socket(int domain, int type, int protocol);
extern int bind(int sockfd, char* addr_struct, int addrlen);

// Extra higer levell stuff
// Suffix Naming Convention: _ext (Extended) or _util (Utility)
extern int exec_cmd(string cmd);
extern int file_size(string path);
extern int last_error();
extern int get_nanos();
extern int yield_cpu();

} // namespace sys

#endif
