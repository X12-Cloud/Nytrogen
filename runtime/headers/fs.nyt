#ifndef FS_NYT
#define FS_NYT

#include <sys.nyt>
#include <string.nyt>
#include <io.nyt>

namespace fs {

const int RDONLY = 0;
const int WRONLY = 1;
const int RDWR   = 2;
const int APPEND = 1024;
const int CREATE = 64;

int open(string path, int flags) {
    return sys::open(path, flags);
}

int close(int fd) {
    return sys::close(fd);
}

int exists(string path) {
    if (sys::file_size(path) == -1) {
        return 0;
    }
    return 1;
}

int size(string path) {
    return sys::file_size(path);
}

int write(int fd, string content) {
    int len = std::strlen(content);
    return sys::write(fd, content, len);
}


string read(int fd, int length) {
    // Prot: PROT_READ|PROT_WRITE (3), Flags: MAP_ANONYMOUS|MAP_PRIVATE (34)
    char* addr = "x";
    char* buffer = sys::mmap(addr, length + 1, 3, 34, -1, 0);
    sys::read(fd, buffer, length);
    return (string)buffer;
}

int write(int fd, string content) {
    int len = std::strlen(content);
    return sys::write(fd, content, len);
}

string read_all(string path) {
    int size = sys::file_size(path);
    if (size <= 0) { return ""; }

    int fd = sys::open(path, 0);
    char* buf = std::malloc(size + 1);
    sys::read(fd, buf, size);
    sys::close(fd);

    return (string)buf;
}


} // namespace fs

#endif
