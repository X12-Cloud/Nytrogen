#ifndef IO_NYT
#define IO_NYT

namespace math {

namespace constants {
    double E = 2.718281828459045d;
    double PI = 3.141592653589793d;
} // namespace constants

double sqrt(double x) {
    return __builtin_sqrt(x);
}
double abs(double x) {
    return __builtin_abs(x);
}
double round(double x) {
    return __builtin_round(x);
}

double sin(double x);
double cos(double x);
double tan(double x);

} // namespace math

#endif
