#ifndef IO_NYT
#define IO_NYT

namespace std {

// Constants
const int in = 0;
const int out = 1;
const int err = 2;

// Output
extern int println(string x);
extern int puts(string x);
extern int putchar(char c);

// Input
extern string readln();
extern int getchar();

// Error output
extern int err(string x);

// Memory
extern char* malloc(int size);
extern void free(char* ptr);

} // namespace std

#endif
