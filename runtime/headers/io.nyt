#ifndef IO_NYT
#define IO_NYT

namespace std {

// Output
extern int println(string x);
extern int putst(string x);
extern int putch(char c);

// Input
extern string readln();
extern char getch();

// Error output
extern int err(string x);

// Memory
extern int ny_strlen(string s);
extern char* ny_malloc(int size);
extern void ny_free(char* ptr);

} // namespace std

#endif
